{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=LnuWebProject;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "LnuWebProject",
    "Audience": "LnuWebProjectClient",
    "ExpiresMinutes": 60
  },
  "Jobs": {
    "MinMatrixSize": 2,
    "MaxMatrixSize": 5000,
    "MaxActiveJobsPerUser": 3,
    "MaxStoredJobsPerUser": 20,
    "MaxComputeSeconds": 300,
    "SecondsPerCubedSize": 9e-10
  },
  "Nodes": {
    "Endpoints": [
      { "Id": "node-1", "Url": "http://localhost:6001" },
      { "Id": "node-2", "Url": "http://localhost:6002" }
    ]
  },
  "Admin": {
    "Emails": []
  }
}